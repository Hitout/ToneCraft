.page-shell {
  min-height: 100vh;
  background: radial-gradient(ellipse at 50% 57.5%, #382717 0%, #15120e 46%, #050505 100%);
}

.content {
  width: 100%;
  max-width: 430px;
  box-sizing: border-box;
  margin: 0 auto;
  padding: 70px 22px calc(20px + env(safe-area-inset-bottom));
}

.mode-navigation {
  position: fixed;
  z-index: 20;
  top: 0;
  left: 0;
  width: 100%;
  box-sizing: content-box;
}

.mode-navigation-content {
  width: 100%;
  max-width: 430px;
  height: 100%;
  box-sizing: border-box;
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
}

.selector-card,
.summary-card {
  box-sizing: border-box;
  border: 1px solid #363129;
  border-radius: 20px;
  background: linear-gradient(135deg, #26231e, #11100d);
}

.selector-card { height: 66px; display: flex; align-items: center; }

.selector-cell {
  flex: 1;
  min-width: 0;
  height: 100%;
  padding: 0 16px;
  display: flex;
  align-items: center;
  box-sizing: border-box;
}

.selector-divider { width: 1px; height: 47px; background: #363129; }

.selector-icon {
  flex: 0 0 31px;
  width: 31px;
  height: 31px;
  margin-right: 10px;
  display: block;
}

.selector-text { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.selector-caption { color: rgba(255, 255, 255, 0.37); font-size: 11px; line-height: 14px; }

.selector-value {
  overflow: hidden;
  color: #fff;
  font-size: 15px;
  font-weight: 700;
  line-height: 20px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.selector-chevron {
  width: 8px;
  height: 8px;
  box-sizing: border-box;
  margin-right: 4px;
  border-right: 1.5px solid #f4e9d2;
  border-bottom: 1.5px solid #f4e9d2;
  color: transparent;
  font-size: 0;
  line-height: 0;
  transform: rotate(45deg) translate(-1px, -1px);
}

.status-banner {
  min-height: 48px;
  box-sizing: border-box;
  margin-top: 10px;
  padding: 7px 14px;
  display: flex;
  align-items: center;
  border: 1px solid rgba(254, 3, 1, 0.35);
  border-radius: 14px;
  color: #ffe2d7;
  background: #2b1714;
}

.status-icon {
  flex: 0 0 20px;
  width: 20px;
  height: 20px;
  margin-right: 9px;
  display: block;
}

.status-copy { flex: 1; color: #f4e9d2; font-size: 11px; }
.status-action {
  height: 32px;
  margin-left: 10px;
  display: flex;
  align-items: center;
  color: #e2a141;
  font-size: 12px;
  white-space: nowrap;
}

.gauge-wrap { margin-top: 10px; }

.trend-wrap { height: 126px; }

.summary-card { min-height: 108px; margin-top: 24px; padding: 10px 14px 12px; }
.summary-heading { display: flex; align-items: center; }

.summary-title {
  flex: 1;
  overflow: hidden;
  color: #f4e9d2;
  font-size: 12px;
  font-weight: 600;
  line-height: 16px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.automatic-control {
  margin-left: 8px;
  padding: 8px 0;
  display: flex;
  align-items: center;
  box-sizing: content-box;
}
.automatic-label { color: #f4e9d2; font-size: 10px; }

.automatic-switch {
  width: 30px;
  height: 16px;
  box-sizing: border-box;
  margin-left: 4px;
  padding: 1px;
  border-radius: 16px;
  background: #a4a4a4;
  transition: background 160ms ease;
}

.automatic-switch.is-on { background: #72e85c; }
.automatic-thumb { width: 14px; height: 14px; border-radius: 50%; background: #fff; transition: transform 160ms ease; }
.automatic-switch.is-on .automatic-thumb { transform: translateX(14px); }

.target-row { margin-top: 12px; display: flex; justify-content: space-between; }
.target-item { flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: center; }

.target-note {
  width: 38px;
  height: 38px;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px solid rgba(255, 255, 255, 0.09);
  border-radius: 50%;
  color: #f4e9d2;
  font-size: 17px;
  transition: color 180ms ease, border-color 180ms ease, background 180ms ease;
}

.target-note-label { display: flex; align-items: baseline; }
.target-note-name { line-height: 1; }
.target-octave { align-self: auto; margin: 0 0 0 1px; font-size: 9px; line-height: 1; }
.target-frequency { margin-top: 4px; font-size: 7.5px; line-height: 10px; white-space: nowrap; }
.chromatic-summary { min-height: 84px; display: flex; align-items: center; }

.chromatic-symbol {
  width: 48px;
  height: 48px;
  box-sizing: border-box;
  margin-right: 14px;
  border: 1px solid rgba(114, 232, 92, 0.5);
  border-radius: 50%;
  color: #72e85c;
  background: rgba(114, 232, 92, 0.12);
  font-size: 24px;
  line-height: 48px;
  text-align: center;
}

.chromatic-copy { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.chromatic-title { color: #f4e9d2; font-size: 14px; font-weight: 600; line-height: 18px; }
.summary-description { margin-top: 4px; color: rgba(255, 255, 255, 0.58); font-size: 11px; }
.chromatic-frequency { margin-top: 4px; color: #72e85c; font-size: 11px; }

.sheet-backdrop {
  position: fixed;
  z-index: 30;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: flex-end;
  background: rgba(0, 0, 0, 0.72);
}

.bottom-sheet {
  width: 100%;
  max-height: 85vh;
  box-sizing: border-box;
  overflow-y: auto;
  padding: 10px 16px calc(18px + env(safe-area-inset-bottom));
  border-top: 2px solid #363129;
  border-radius: 20px 20px 0 0;
  background: linear-gradient(160deg, #26231e, #0e0d0b);
}

.sheet-header {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16px;
}

.sheet-handle { width: 38px; height: 4px; margin: 0 auto 14px; border-radius: 2px; background: #514a3d; }
.sheet-title { color: #f4e9d2; font-size: 16px; font-weight: 700; line-height: 19px; text-align: center; }

.sheet-option {
  box-sizing: border-box;
  margin-bottom: 7px;
  min-height: 55px;
  padding: 11px 20px;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 0;
  border-radius: 20px;
  color: rgba(255, 255, 255, 0.48);
  font-size: 15px;
  font-weight: 500;
  line-height: 18px;
  text-align: center;
  white-space: normal;
}

.sheet-option.is-selected { color: #fff; background: linear-gradient(135deg, #e2a141, #ad580e); font-weight: 600; }
