.beat-slider {
  width: 100%;
  height: 24px;
  position: relative;
}

.slider-track {
  position: absolute;
  top: 0;
  height: 24px;
  border-radius: 5px;
  background: linear-gradient(135deg, #2d2922, #1f1d16);
}

.slider-motion {
  position: absolute;
  top: 0;
  height: 24px;
}

.slider-thumb {
  position: absolute;
  width: 16px;
  height: 24px;
  left: 0;
  top: 0;
  border-radius: 5px;
  background: linear-gradient(180deg, #ffe4ab, #da9a33);
  box-shadow: 0 0 16px rgba(255, 198, 90, 0.65);
  overflow: visible;
}

.slider-thumb.is-playing {
  animation-name: slider-slide;
  animation-timing-function: ease-in-out;
  animation-iteration-count: infinite;
  animation-direction: alternate;
}

@keyframes slider-slide {
  from { left: 0; }
  to { left: calc(100% - 16px); }
}
