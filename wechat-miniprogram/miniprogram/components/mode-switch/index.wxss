.mode-switch-track {
  position: relative;
  width: 170px;
  height: 42px;
  box-sizing: border-box;
  overflow: hidden;
  border: 1px solid #24201b;
  border-radius: 22px;
  background: linear-gradient(135deg, #191511, #14130f);
}

.mode-switch-thumb {
  position: absolute;
  top: 3px;
  width: 102px;
  height: 36px;
  border-radius: 19px;
  background: linear-gradient(135deg, #e2a141, #ad580e);
  transition: none;
}

.mode-switch-thumb.is-metronome { left: 3px; }
.mode-switch-thumb.is-tuner { left: 65px; }

.mode-target {
  position: absolute;
  top: 3px;
  height: 36px;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border-radius: 18px;
  color: rgba(255, 255, 255, 0.32);
  font-size: 12px;
  font-weight: 400;
  line-height: 36px;
  white-space: nowrap;
  transition: none;
}

.mode-target.is-selected {
  color: #fff;
  font-size: 16px;
  font-weight: 700;
}

.mode-target-metronome { left: 3px; }
.mode-target-metronome.is-selected { width: 102px; }
.mode-target-metronome.is-idle { width: 62px; }

.mode-target-tuner.is-selected { left: 65px; width: 102px; }
.mode-target-tuner.is-idle { left: 105px; width: 62px; }
