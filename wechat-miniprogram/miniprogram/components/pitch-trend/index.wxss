.trend-card {
  width: 100%;
  height: 124px;
  margin-top: 2px;
  box-sizing: border-box;
  overflow: hidden;
  padding: 12px 12px 12px 14px;
  border: 1px solid #363129;
  border-radius: 20px;
  background: linear-gradient(135deg, #26231e, #11100d);
}

.trend-chart {
  position: relative;
  width: 100%;
  height: 98px;
  display: block;
  overflow: hidden;
}

.trend-grid-line {
  position: absolute;
  top: 0;
  right: 0;
  left: 28px;
  height: 1px;
  background: rgba(255, 255, 255, 0.16);
}

.trend-grid-label {
  position: absolute;
  left: 0;
  width: 24px;
  height: 12px;
  color: rgba(255, 255, 255, 0.28);
  font-size: 8px;
  line-height: 12px;
  text-align: left;
  white-space: nowrap;
}

.trend-in-tune-band {
  position: absolute;
  right: 0;
  left: 28px;
  background: rgba(105, 255, 195, 0.18);
}

.trend-segment {
  position: absolute;
  left: 0;
  top: 0;
  height: 2px;
  border-radius: 2px;
  transform-origin: left center;
}
